{
  "manifest_version": 3,
  "name": "SyncOn — Browser Screen Time",
  "version": "1.0.0",
  "description": "Private, local-first Chrome screen-time tracking and website limits for SyncOn.",
  "permissions": [
    "alarms",
    "idle",
    "notifications",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://nqpristylxavyexqgjtp.supabase.co/*"
  ],
  "incognito": "split",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SyncOn",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_page": "dashboard/dashboard.html"
}
