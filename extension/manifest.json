{
  "manifest_version": 3,
  "name": "SyncOn — Browser Screen Time",
  "version": "1.0.0",
  "description": "Private, local-first Chrome screen-time tracking and website limits for SyncOn.",
  "permissions": [
    "alarms",
    "idle",
    "storage",
    "tabs",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SyncOn",
    "default_popup": "popup/popup.html"
  },
  "options_page": "dashboard/dashboard.html",
  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
